diff --git a/examples/rust/http-server.rs b/examples/rust/http-server.rs
index 8a3f7ecd..207dbf29 100644
--- a/examples/rust/http-server.rs
+++ b/examples/rust/http-server.rs
@@ -554,6 +554,10 @@ fn server(local: SocketAddrV4) -> Result<()> {
                     match e.errno {
                         #[cfg(feature = "tcp-migration")]
                         demikernel::ETCPMIG => { server_log!("migrated {:?} polled", qd) },
+                        // The send buffer is full: the offered load is above what this
+                        // connection can drain. Drop the response and keep serving rather
+                        // than taking the whole server down.
+                        libc::EBUSY => { server_log!("send buffer full on {:?}", qd) },
                         _ => panic!("operation failed: {}", e),
                     }
                 }
