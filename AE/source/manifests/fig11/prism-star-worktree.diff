+                (buf_len, true)
+            }
+        };
+        let mut segment_data = segment.clone();
+        segment_data.trim(buf_len - frame_size_bytes);
+        segment.adjust(frame_size_bytes);
+        let segment_data_len: u32 = segment_data.len() as u32;
+
+        let rto: Duration = cb.rto();
