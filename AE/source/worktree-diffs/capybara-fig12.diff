+            if self.active_migrations.contains_key(&remote) {
+                if origin_is_self {
+                    // Our own PREPARE was steered back: we are the current
+                    // min-workload server, so keep the connection.
+                    capy_log_mig!("It returned back to itself, maybe it's the current-min-workload server");
+                    self.active_migrations.remove(&remote);
+                    return Ok(TcpmigReceiveStatus::ReturnedBySwitch(hdr.origin, hdr.client));
+                }
+                // A retransmitted PREPARE for a migration already in progress:
+                // fall through and let the existing state machine re-ack it,
+                // instead of destroying the in-flight handover.
+                capy_log_mig!("duplicate PREPARE for in-flight migration, re-acking");
+            } else {
+                self.active_migrations.insert(remote, active);
             }
